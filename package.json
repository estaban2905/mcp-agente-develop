{
  "name": "mcp-dev-agent",
  "version": "1.0.0",
  "description": "AI Development Agent powered by Model Context Protocol (MCP)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/web/index.html dist/web/index.html",
    "start": "node dist/index.js",
    "web": "node dist/web/server.js",
    "server": "node dist/mcp/server.js",
    "dev": "tsx src/index.ts",
    "dev:web": "tsx src/web/server.ts",
    "dev:ui": "tsx src/web/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "chalk": "^5.3.0",
    "dotenv": "^16.4.7",
    "express": "^4.22.1",
    "node-pty": "^1.1.0",
    "openai": "^4.77.0",
    "ora": "^8.1.1",
    "readline": "^1.3.0",
    "ws": "^8.20.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "ai",
    "agent",
    "development",
    "openai"
  ],
  "author": "MCP Dev Agent",
  "license": "MIT"
}
