# =============================================
#   MCP Dev Agent - Variables de Entorno
# =============================================

# OpenAI API Key (obligatoria)
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=tu-api-key-aqui

# Modelo de OpenAI a usar
# Opciones: gpt-4o, gpt-4o-mini, gpt-4-turbo
OPENAI_MODEL=gpt-4o

# Directorio base de trabajo del agente
# El agente solo operará dentro de este directorio
WORKSPACE_DIR=./workspace

# Nivel de logs: debug | info | warn | error
LOG_LEVEL=info

# Máximo de iteraciones del agent loop (seguridad)
MAX_ITERATIONS=20

# Timeout para comandos de terminal (ms)
COMMAND_TIMEOUT=30000

# Comandos bloqueados (separados por coma)
BLOCKED_COMMANDS=rm -rf,sudo,shutdown,reboot,mkfs,dd,passwd

# Puerto del servidor MCP (si se usa HTTP transport)
MCP_SERVER_PORT=3001
